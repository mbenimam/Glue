#version 450 core
// Edge-avoiding a-trous wavelet denoiser (Dammertz et al. 2012, without the temporal part).
// Each pass blurs the mean radiance with a 5x5 B3-spline kernel whose taps are spaced `uStep`
// pixels apart. A tap's weight is cut where its colour, its first-hit albedo or its first-hit
// normal differ from the centre pixel. Running passes with steps 1, 2, 4, ... blurs a wide
// area with few taps, and the edge weights keep object boundaries sharp.
//
// Inputs are the accumulation (rgb = sum, a = count) on the first pass, and the output of the
// previous pass (rgb = mean, a = 1) afterwards: both read as rgb / a.
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, binding = 0) uniform image2D uIn;           // colour to filter
layout(rgba32f, binding = 1) uniform image2D uAlbedo;       // sum of first-hit albedo, a = count
layout(rgba32f, binding = 2) uniform image2D uNormal;       // sum of first-hit shading normals
layout(rgba32f, binding = 3) uniform image2D uOut;          // filtered colour, a = 1

uniform int uWidth, uHeight;
uniform int uStep;             // dilation of this pass: 1, 2, 4, ...
uniform float uSigmaC;         // colour edge stop: larger keeps more blur across colour edges
uniform float uSigmaA;         // albedo edge stop
uniform float uSigmaN;         // normal edge stop: exponent on the cosine between normals

float B3(int k) {               // B3-spline row of the a-trous kernel: 1, 4, 6, 4, 1 over 16
    return k == 0 ? 6.0 / 16.0 : (abs(k) == 1 ? 4.0 / 16.0 : 1.0 / 16.0);
}

vec3 mean(vec4 s) { return s.a > 0.0 ? s.rgb / s.a : vec3(0.0); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= uWidth || p.y >= uHeight) return;

    vec3 cP = mean(imageLoad(uIn, p));
    vec3 aP = mean(imageLoad(uAlbedo, p));
    vec3 nRaw = imageLoad(uNormal, p).rgb;
    float nLenP = length(nRaw);
    vec3 nP = nLenP > 0.0 ? nRaw / nLenP : vec3(0.0);

    vec3 sum = vec3(0.0);
    float wSum = 0.0;
    for (int j = -2; j <= 2; ++j) {
        for (int i = -2; i <= 2; ++i) {
            ivec2 q = p + ivec2(i, j) * uStep;
            if (q.x < 0 || q.y < 0 || q.x >= uWidth || q.y >= uHeight) continue;

            vec3 cQ = mean(imageLoad(uIn, q));
            if (any(isnan(cQ)) || any(isinf(cQ))) continue;   // a non-finite tap would poison the sum
            vec3 aQ = mean(imageLoad(uAlbedo, q));
            vec3 nQraw = imageLoad(uNormal, q).rgb;
            float nLenQ = length(nQraw);
            vec3 nQ = nLenQ > 0.0 ? nQraw / nLenQ : vec3(0.0);

            float wc = exp(-dot(cP - cQ, cP - cQ) / (uSigmaC * uSigmaC + 1e-8));
            float wa = exp(-dot(aP - aQ, aP - aQ) / (uSigmaA * uSigmaA + 1e-8));
            // Sky and light pixels have no normal: they only mix with each other.
            float wn = (nLenP == 0.0 || nLenQ == 0.0) ? float(nLenP == nLenQ)
                                                      : pow(max(dot(nP, nQ), 0.0), uSigmaN);
            float w = B3(i) * B3(j) * wc * wa * wn;
            sum += w * cQ;
            wSum += w;
        }
    }
    vec3 outC = wSum > 0.0 ? sum / wSum : cP;
    imageStore(uOut, p, vec4(outC, 1.0));
}
