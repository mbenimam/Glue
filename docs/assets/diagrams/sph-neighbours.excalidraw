   "updated": 1,
   "link": null,
   "locked": false,
   "strokeSharpness": "sharp",
   "text": "i sits somewhere in the dark cell. A disc of radius\nh = cell side can cross at most one cell boundary\nin each direction, so every j with r_ij <= h lies in\nthe 3 x 3 block (3 x 3 x 3 = 27 cells in 3D).",
   "originalText": "i sits somewhere in the dark cell. A disc of radius\nh = cell side can cross at most one cell boundary\nin each direction, so every j with r_ij <= h lies in\nthe 3 x 3 block (3 x 3 x 3 = 27 cells in 3D).",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
